# hostap wpa_supplicant build configuration for the M1 Plus (tools/mod_wpa.py copies it to wpa_supplicant/.config).
# Station only: nl80211 on the stock RTL8733BS driver, the stock OpenSSL 1.1.1 and libnl 3, no dbus, no AP/P2P/mesh.
# PMF (802.11w) is always built in since hostap 2.10.
CONFIG_DRIVER_NL80211=y
CONFIG_LIBNL32=y
CONFIG_CTRL_IFACE=y
CONFIG_BACKEND=file
CONFIG_TLS=openssl
CONFIG_TLSV11=y
CONFIG_TLSV12=y
# The debug messages (wpa_printf, -d) are about 135 KB compressed and the rootfs has about 500 KB to spare. Events for the UI
# (CTRL-EVENT-*, including EAP failures and certificate errors) and `wpa_cli status` stay.
CONFIG_NO_STDOUT_DEBUG=y

# WPA3-Personal, Enhanced Open, WPA3-Enterprise 192 bit, fast roaming, BSS transition, background scans
CONFIG_SAE=y
CONFIG_OWE=y
CONFIG_SUITEB=y
CONFIG_SUITEB192=y
CONFIG_IEEE80211R=y
CONFIG_WNM=y
CONFIG_BGSCAN_SIMPLE=y
CONFIG_IEEE80211AC=y
CONFIG_IEEE80211AX=y

# WPA-Enterprise: the methods campus and office networks use, plus WPS (stock has it)
CONFIG_IEEE8021X_EAPOL=y
CONFIG_EAP_MD5=y
CONFIG_EAP_MSCHAPV2=y
CONFIG_EAP_TLS=y
CONFIG_EAP_TLSV1_3=y
CONFIG_EAP_PEAP=y
CONFIG_EAP_TTLS=y
CONFIG_EAP_GTC=y
CONFIG_EAP_PWD=y
CONFIG_PKCS12=y
CONFIG_WPS=y
